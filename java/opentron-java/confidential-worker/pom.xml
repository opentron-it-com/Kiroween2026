<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.opentron</groupId>
    <artifactId>cjae-confidential-worker</artifactId>
    <version>0.1.0</version>
    <name>CJAE Confidential Worker</name>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.6</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <onnxruntime.version>1.22.0</onnxruntime.version>
        <bouncycastle.version>1.80</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.opentron</groupId>
            <artifactId>cjae-spring-boot-starter</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-cbor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>${onnxruntime.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cjae-confidential-worker</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-confidential-backend-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../backend/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-confidential-backend-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../backend/src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                    <includes>
                        <include>org/opentron/backend/security/confidential/ConfidentialSegment.java</include>
                        <include>org/opentron/backend/security/confidential/ConfidentialRuntimeVerifier.java</include>
                        <include>org/opentron/backend/security/confidential/ConfidentialExecutionPolicy.java</include>
                        <include>org/opentron/backend/security/confidential/ConfidentialAI.java</include>
                        <include>org/opentron/backend/security/confidential/ConfidentialAIAspect.java</include>
                        <include>org/opentron/backend/security/confidential/gateway/*.java</include>
                        <include>org/opentron/backend/security/confidential/gateway/api/**/*.java</include>
                        <include>org/opentron/backend/security/confidential/gateway/aws/**/*.java</include>
                        <include>org/opentron/backend/security/confidential/gateway/gcp/**/*.java</include>
                        <include>org/opentron/backend/security/confidential/gateway/onnx/**/*.java</include>
                        <include>org/opentron/cjae/worker/**/*.java</include>
                    </includes>
                    <testIncludes>
                        <testInclude>org/opentron/backend/security/confidential/gateway/api/OidcJwtGatewayCredentialAuthenticatorTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/api/GatewayOidcAuthenticationConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/AwsNitroConfidentialGatewayConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/AwsNitroOidcGatewayApiConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/AwsNitroConfidentialRuntimeVerifierTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/AwsNitroEnclaveKeyReleaseServiceTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/LinuxVsockParentKmsTransportTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/LinuxVsockHealthBridgeTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroConfidentialBenchmarkOperationTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroConfidentialBenchmarkRunnerTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroRagPipelineTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroRagBenchmarkRunnerTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/aws/PanamaNitroEnclaveAttestationSourceTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroStartupAttestationRunnerTest.java</testInclude>
                        <testInclude>org/opentron/cjae/worker/AwsNitroHealthVsockConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/gcp/GcpConfidentialGatewayConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/gcp/GcpConfidentialGatewayTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/gcp/GoTpmGcpAttestationTokenSourceTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/ConfidentialGatewayServiceTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/JdbcSecureContextConsumptionStoreTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/api/ConfidentialGatewayControllerTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/api/GcpClientAttestationControllerTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/api/GatewayTlsRequirementConfigurationTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/onnx/BertWordPieceTokenizerTest.java</testInclude>
                        <testInclude>org/opentron/backend/security/confidential/gateway/PiiDetectorEvaluationTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.opentron.cjae.worker.ConfidentialWorkerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
