[Unit]
Description=CJAE Nitro Enclave opaque TLS gateway relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
EnvironmentFile=/etc/cjae/aws-nitro-gateway-vsock-proxy.env
ExecStart=/usr/bin/python3 /opt/cjae/aws_nitro_gateway_vsock_proxy.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_VSOCK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
